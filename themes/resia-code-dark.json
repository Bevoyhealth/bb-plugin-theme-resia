  "tokenColors": [
    {
      "settings": {
        "foreground": "#ebebeb",
        "background": "#181818"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#a0a0a0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and tags",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "entity.name.tag",
        "punctuation.definition.tag",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#ce7a72"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#5aa17a"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ef9966"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9fcbd3"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#ef9966"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ebebeb"
      }
    },
    {
      "name": "Punctuation, operators, parameters",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "variable.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#b8b8b8"
      }
    },
    {
      "name": "Attributes and object keys",
      "scope": [
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.object.property",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#e0b345"
      }
    },
    {
      "name": "Regex, escapes, decorators",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#db82b2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e16862"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ef9966",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ebebeb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ebebeb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ef9966"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#5aa17a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#e16862"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e0b345"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#9fcbd3"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#ebebeb",
    "parameter": "#b8b8b8",
    "property": "#e0b345",
    "function": "#9fcbd3",
    "method": "#9fcbd3",
    "type": "#ef9966",
    "class": "#ef9966",
    "interface": "#ef9966",
    "enumMember": "#ef9966",
    "keyword": "#ce7a72",
    "decorator": "#db82b2",
    "regexp": "#db82b2",
    "string": "#5aa17a",
    "number": "#ef9966",
    "comment": {
      "foreground": "#a0a0a0",
      "italic": true
    }
  }
}